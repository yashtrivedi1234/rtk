# Public frontend config only — never put secrets (JWT signing keys, DB passwords) in VITE_*.
#
# Development against json-server (CORS enabled on the server):
VITE_BACKEND_URL=http://localhost:3000

# Example when you have a real API on another host/port:
# VITE_BACKEND_URL=http://localhost:5000/api
# VITE_BACKEND_URL=https://api.example.com/api
#
# Optional relative URL (dev only — requires Vite proxy in vite.config.js):
# VITE_BACKEND_URL=/api
